---
# Per-user secret env vars, templated into ~/.zsh_secrets (chmod 600).
#
# Setup on YOUR machine (values below stay empty in git):
#   cp vars/secrets.yml.example vars/secrets.yml
#   $EDITOR vars/secrets.yml                 # fill in real values
#   ansible-vault encrypt vars/secrets.yml   # choose a master password
#   ansible-playbook main.yml --ask-vault-pass
#
# vars/secrets.yml is gitignored either way; the vault encryption is
# defence-in-depth for local disk/backups.
secret_env: {}
# secret_env:
#   GITHUB_TOKEN: ""
#   SOME_API_KEY: ""
